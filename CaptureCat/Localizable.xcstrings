          }
        }
      }
    },
    "캡처캣이 사용성을 개선했어요.\n지금 바로 업데이트하고 편하게 사용해보세요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CaptureCat has improved its usability.\nUpdate now and enjoy a smoother experience!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャキャットが使いやすくなったよ。\n今すぐアップデートして、もっと快適に使ってみてね！"
          }
        },
        "ko" : {
          "stringUnit" : {
