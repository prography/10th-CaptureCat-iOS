        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete %lld items? Deleted items cannot be restored."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件の項目を削除しますか？\n削除したら元に戻せないよ。"
